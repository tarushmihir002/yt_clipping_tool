# Copy to .env and fill in. All optional except GEMINI_API_KEY if you want AI titles/highlights.

# Google AI Studio key (free tier) -> https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Whisper captioning (local, free). model: tiny|base|small|medium|large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8

# OAuth local-server port (must match a redirect the OAuth client allows; desktop clients allow any localhost)
OAUTH_PORT=8765

# YouTube download auth — needed to get past "Sign in to confirm you're not a bot".
# Option 1: export cookies.txt from your logged-in browser and point to it:
# COOKIES_FILE=C:\path\to\cookies.txt
# Option 2: read cookies straight from a Chrome profile (profile that's logged into your account):
# COOKIES_FROM_BROWSER=chrome:Profile 2

# Override working/output dirs if you like
# CLIP_WORK_DIR=
# CLIP_OUTPUT_DIR=
